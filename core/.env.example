# Copy to .env (gitignored). Keep exactly one LUMINA_CHECKPOINT line uncommented; the API loads .env from the directory it starts in.
# LUMINA_CHECKPOINT=checkpoints/full/epoch_0010.pt
# LUMINA_CHECKPOINT=checkpoints/full/epoch_0020.pt
# LUMINA_CHECKPOINT=checkpoints/full/epoch_0030.pt
# LUMINA_CHECKPOINT=checkpoints/full/epoch_0040.pt
# LUMINA_CHECKPOINT=checkpoints/full/final.pt
LUMINA_CHECKPOINT=checkpoints/lol/final.pt
# Quality-first photo settings. Lower curve scale only after inspecting local benchmark outputs.
LUMINA_DEFAULT_CURVE_SCALE=1
LUMINA_MAX_CONCURRENCY=1
